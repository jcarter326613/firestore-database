{
    "name": "firestore-database",
    "version": "0.1.0",
    "description": "A type-safe Firestore database package for modeling, querying, and migrating application data with Firebase.",
    "license": "Unlicense",
    "keywords": [
        "firebase",
        "firestore",
        "firebase-admin",
        "zod",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jcarter326613/firestore-database.git"
    },
    "bugs": {
        "url": "https://github.com/jcarter326613/firestore-database/issues"
    },
    "homepage": "https://github.com/jcarter326613/firestore-database#readme",
    "type": "module",
    "packageManager": "pnpm@11.23.0",
    "engines": {
        "node": ">=22"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --exclude test/integration/**",
        "test:integration": "firebase emulators:exec --only firestore --project firestore-database-integration \"GCLOUD_PROJECT=firestore-database-integration pnpm test:integration:run\"",
        "test:integration:run": "vitest run test/integration",
        "typecheck": "tsc --noEmit --project tsconfig.json",
        "changeset": "changeset"
    },
    "dependencies": {
        "firebase-admin": "^13.6.0",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.2",
        "@types/node": "^22.15.3",
        "firebase-tools": "^14.27.0",
        "prettier": "^3.9.6",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    }
}
